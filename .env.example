# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas ya local)
MONGO_URI=mongodb://127.0.0.1:27017/influencer_platform

# Frontend ka URL (CORS ke liye)
CLIENT_URL=http://localhost:3000

# Platform ka naam (abhi final nahi)
PLATFORM_NAME=Influnexa
# Asal website (sitemap aur markdown ke links)
SITE_URL=https://influnexa.com

# JWT secrets: lambi random strings. Banane ke liye:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Email (password reset aur agreement ke codes) Resend API se.
# resend.com -> API Keys -> Create API key. Khali ho to development mein code terminal pe print hota hai
RESEND_API_KEY=
# Bhejne wala: Resend mein verified domain ka address, jaise: Influnexa <info@influnexa.com>
# Khali ho to Resend ka test sender (onboarding@resend.dev), jo sirf aap ke Resend account wali email pe bhejta hai
MAIL_FROM=

# "Sign in / Sign up with Google": Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Authorized JavaScript origins mein frontend ka domain daalein.
# Ye client ID public hai (secret nahi). Khali ho to Google wala button nahi dikhta
GOOGLE_CLIENT_ID=

# Followers khud lane ke liye (talent haath se nahi likhta). Khali ho to woh platform skip.
# YouTube: Google Cloud Console -> APIs & Services -> Library -> "YouTube Data API v3" Enable ->
# Credentials -> Create credentials -> API key (key ko sirf YouTube Data API v3 tak restrict karein)
YOUTUBE_API_KEY=
# Instagram, Facebook, X, TikTok: app.tavily.com pe signup, dashboard se key (free: 1,000 credits/mahina)
TAVILY_API_KEY=
# Optional: regex se number na nikle to Groq text se nikale (console.groq.com -> API Keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# AI influencer suggestions (admin panel -> AI suggestions). TAVILY_API_KEY aur GROQ_API_KEY
# zaroori hain, YOUTUBE_API_KEY se YouTube channels aur photos verify hote hain.
# Har kitni der baad 5 naye influencers ka group: 3s (testing), 10m, 2h, 1d (production).
# Badal ke server restart / Vercel redeploy karein
SUGGESTIONS_INTERVAL=1d
# Har group mein kitne Pakistani (baqi 5 mein se international), 1 se 4
SUGGESTIONS_NATIONAL_COUNT=3
# Sirf woh log jin ke asal (verified) followers kam az kam itne hon
SUGGESTIONS_MIN_FOLLOWERS=10000
# Ek talent ke followers kitne ghante mein ek dafa dhoondein (0 / khali = koi limit nahi, 24 = din mein ek dafa)
FOLLOWERS_REFRESH_LIMIT_HOURS=0
# Roz ka cron (/api/cron/followers) isi secret ke baghair nahi chalta. Koi bhi lambi random string
CRON_SECRET=

# Photos / logos Cloudinary pe (laga ho to sab uploads wahin, warna disk / MongoDB).
# cloudinary.com -> Dashboard -> "API environment variable" poora yahan:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Ya CLOUDINARY_URL ki jagah teeno alag alag
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary ke andar folder ka naam
CLOUDINARY_FOLDER=influencer-platform

# Payments: Polar.sh (Pro plans). Khali ho to sab kuch free aur bila hadd, jaise pehle.
# 1) polar.sh (test ke liye sandbox.polar.sh) -> Organization -> Settings -> Developers -> New token
#    (scopes: checkouts:write, products:read, subscriptions:read, customer_sessions:write)
POLAR_ACCESS_TOKEN=
# 2) sandbox = test cards, production = asal paise. Token usi jagah ka hona chahiye
POLAR_SERVER=sandbox
# 3) Settings -> Webhooks -> Add endpoint: https://<backend-domain>/api/billing/webhook
#    Format: Raw. Events: subscription.created, .active, .updated, .canceled, .uncanceled, .revoked
#    Wahan ka secret yahan
POLAR_WEBHOOK_SECRET=
# 4) Products -> New product (Subscription, monthly) har plan ke liye, phir us ki ID (Copy ID).
#    Jis ka product khali ho, us account type ke liye koi paid plan / hadd nahi
POLAR_PRODUCT_BUSINESS_PRO=
POLAR_PRODUCT_MANAGER_PRO=
POLAR_PRODUCT_TALENT_PRO=
